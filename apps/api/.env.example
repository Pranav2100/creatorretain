
# Frontend base URL used in invitation links
APP_URL="http://localhost:3000"

# Invitations
INVITATION_TTL_DAYS=30

# Email: console (logs only) or smtp
EMAIL_BACKEND="console"
EMAIL_FROM_NAME="CreatorRetain"
EMAIL_FROM_ADDRESS="invites@example.com"

# SMTP (used when EMAIL_BACKEND=smtp; defaults suit Mailpit locally)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Logging
LOG_LEVEL="INFO"
